<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_maintenance_tree" model="ir.ui.view">
        <field name="name">real_estate.maintenance_request.tree</field>
        <field name="model">real_estate.maintenance_request</field>
        <field name="arch" type="xml">
            <tree string="Maintenance Requests">
                <field name="name"/>
                <field name="lease_id"/>
                <field name="issue_type"/>
                <field name="urgency"/>
                <field name="assigned_to"/>
                <field name="scheduled_date"/>
                <field name="completion_date"/>
                <field name="actual_cost"/>
                 <field name="urgency"/>

            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_maintenance_form" model="ir.ui.view">
        <field name="name">real_estate.maintenance_request.form</field>
        <field name="model">real_estate.maintenance_request</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="lease_id"/>
                            <field name="issue_type"/>
                            <field name="urgency"/>
                        </group>
                        <group>
                            <field name="assigned_to"/>
                            <field name="scheduled_date"/>
                            <field name="completion_date"/>
                            <field name="actual_cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_maintenance_request" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">real_estate.maintenance_request</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No maintenance requests yet.
            </p>
        </field>
    </record>
    <record id="ir_cron_auto_schedule_emergency_requests" model="ir.cron">
        <field name="name">Maintenance: Auto Schedule Emergency Requests</field>
        <field name="model_id" ref="model_real_estate_maintenance_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_schedule_emergency()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
