<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. واجهة الـ CRM Inherit -->
    <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="write_leadname_text" type="object" string="Write Lead Name" class="oe_highlight"/>
                <button type="action" name="real_estate.action_real_estate_tenant_wizard" string="Create Tenant" class="btn-primary" context="{'default_name': contact_name or name, 'default_phone': phone, 'default_mobile': mobile, 'default_email': email_from}"/>
            </header>
            
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="property_type"/>
                <field name="monthly_rent"/>
                <field name="age_category"/>
                <!--sales man-->
            </xpath>
            
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">sales man</attribute>
            </xpath> 
            
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="string">phone number</attribute>
            </xpath>       
            
            <!--expected date-->
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="string">Expected date</attribute>
                <attribute name="required">1</attribute>
            </xpath>  
        </field>
    </record>

    <!-- 2. الـ Scheduled Action (معدل بـ numbercall الصحيحة) -->
    <data noupdate="1">
        <record id="ir_cron_auto_create_tenant_from_leads" model="ir.cron">
            <field name="name">CRM: Auto Create Tenants from Leads</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_create_tenant_from_leads()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>