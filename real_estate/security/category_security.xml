<odoo>
    <!-- 1. MODULE CATEGORIES                       -->
    <record id="property_category" model="ir.module.category">
        <field name="name">Real Estate property</field>
    </record>
    <record id="tenant_category" model="ir.module.category">
        <field name="name">Real Estate Tenant</field>
    </record>
    <record id="lease_category" model="ir.module.category">
        <field name="name">Real Estate lease</field>
    </record>
    <record id="booking_category" model="ir.module.category">
        <field name="name">Real Estate booking</field>
    </record>
    <record id="maintenance_category" model="ir.module.category">
        <field name="name">Real Estate Maintenance</field>
    </record>
    <record id="lease_wizard_category" model="ir.module.category">
        <field name="name">Real Estate Lease Wizard</field>
    </record>


    <!-- 2. GROUPS & ACCESS RIGHTS  -->
    
    <!-- Property Groups -->
    <record id="group_agent" model="res.groups">
        <field name="name">Real Estate Agent</field>
        <field name="category_id" ref="real_estate.property_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_property_manager" model="res.groups">
        <field name="name">Property Manager</field>
        <field name="category_id" ref="real_estate.property_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    
    <record id="group_property_user" model="res.groups">
        <field name="name">Property user</field>
        <field name="category_id" ref="real_estate.property_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Tenant Groups -->
    <record id="group_tenant" model="res.groups">
        <field name="name">Tenant</field>
        <field name="category_id" ref="real_estate.tenant_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_tenant_manager" model="res.groups">
        <field name="name">Tenant Manager</field>
        <field name="category_id" ref="real_estate.tenant_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_tenant_user" model="res.groups">
        <field name="name">Tenant User</field>
        <field name="category_id" ref="real_estate.tenant_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Lease Groups -->
    <record id="group_lease_manager" model="res.groups">
        <field name="name">Lease Manager</field>
        <field name="category_id" ref="real_estate.lease_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_lease_user" model="res.groups">
        <field name="name">Lease User</field>
        <field name="category_id" ref="real_estate.lease_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Booking Groups -->
    <record id="group_booking_manager" model="res.groups">
        <field name="name">Booking Manager</field>
        <field name="category_id" ref="real_estate.booking_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_booking_user" model="res.groups">
        <field name="name">Booking User</field>
        <field name="category_id" ref="real_estate.booking_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Maintenance Groups -->
    <record id="group_maintenance_manager" model="res.groups">
        <field name="name">Maintenance Manager</field>
        <field name="category_id" ref="real_estate.maintenance_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_maintenance_user" model="res.groups">
        <field name="name">Maintenance User</field>
        <field name="category_id" ref="real_estate.maintenance_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_lease_wizard_manager" model="res.groups">
        <field name="name">Lease Wizard Manager</field>
        <field name="category_id" ref="real_estate.lease_wizard_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_lease_wizard_user" model="res.groups">
        <field name="name">Lease Wizard User</field>
        <field name="category_id" ref="real_estate.lease_wizard_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>


    <!-- 3. RECORD RULES  -->

    <!-- Tenant Rules -->
    <record id="tenant_user_rule" model="ir.rule">
        <field name="name">Tenant: Own Record Only</field>
        <field name="model_id" ref="model_real_estate_tenant"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_tenant_user'))]"/>
    </record>

    <record id="tenant_manager_rule" model="ir.rule">
        <field name="name">Tenant Manager: All Tenant Records</field>
        <field name="model_id" ref="model_real_estate_tenant"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_tenant_manager'))]"/>
    </record>

    <!-- Lease Rules -->
    <record id="lease_manager_rule" model="ir.rule">
        <field name="name">Lease Manager: All Lease Records</field>
        <field name="model_id" ref="model_real_estate_lease"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_lease_manager'))]"/>
    </record>

    <record id="lease_user_rule" model="ir.rule">
        <field name="name">Lease User: Own Lease Records Only</field>
        <field name="model_id" ref="model_real_estate_lease"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_lease_user'))]"/>
    </record>

    <!-- Booking Rules -->
    <record id="booking_manager_rule" model="ir.rule">
        <field name="name">Booking Manager: All Booking Records</field>
        <field name="model_id" ref="model_real_estate_booking"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_booking_manager'))]"/>
    </record>    

    <record id="booking_user_rule" model="ir.rule">
        <field name="name">Booking User: Own Booking Records Only</field>
        <field name="model_id" ref="model_real_estate_booking"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_booking_user'))]"/>
    </record>

    <!-- Maintenance Rules -->
    <record id="maintenance_manager_rule" model="ir.rule">
        <field name="name">Maintenance Manager: All Maintenance Requests</field>
        <field name="model_id" ref="model_real_estate_maintenance_request"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_maintenance_manager'))]"/>
    </record>

    <record id="maintenance_user_rule" model="ir.rule">
        <field name="name">Maintenance User: Assigned To Me Or Created By Me</field>
        <field name="model_id" ref="model_real_estate_maintenance_request"/>
        <field name="domain_force">['|', ('assigned_to', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_maintenance_user'))]"/>
        <field name="perm_create" eval="False"/>
    </record>

    <!-- Property Rules -->
    <record id="property_agent_rule" model="ir.rule">
        <field name="name">Agent: Own Properties Only</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="domain_force">[('agent_id', '=', user.id)]</field> 
        <field name="groups" eval="[(4, ref('group_agent'))]"/>
    </record>
    
    <record id="property_tenant_rule" model="ir.rule">
        <field name="name">Tenant: Leased Properties Only</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="domain_force">[('lease_ids.tenant_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_tenant'))]"/>
    </record>

    <record id="property_manager_rule" model="ir.rule">
        <field name="name">Manager: All Properties</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_property_manager'))]"/>
    </record>    

    <record id="property_rule_by_user" model="ir.rule">
        <field name="name">Property User</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_property_user'))]"/>
    </record>

    
</odoo>
