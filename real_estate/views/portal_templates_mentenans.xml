<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template: My Maintenance Requests Portal -->
    <template id="portal_my_maintenance_requests" name="Tenant Portal - Maintenance Requests">
        <t t-call="portal.portal_layout">
            <div class="container mt-4 o_portal_portlets">
                <!-- Breadcrumbs & Header -->
                <div class="row align-items-center mb-4">
                    <div class="col-lg-8">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb bg-transparent p-0 mb-2">
                                <li class="breadcrumb-item"><a href="/my/home">My Account</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Maintenance Requests</li>
                            </ol>
                        </nav>
                        <h1 class="h3 mb-0 font-weight-bold text-dark">
                            <i class="fa fa-wrench text-primary mr-2"></i> Maintenance Requests
                        </h1>
                    </div>
                </div>

                <!-- Content Grid -->
                <t t-if="maintenance_requests">
                    <div class="row">
                        <t t-foreach="maintenance_requests" t-as="req">
                            <div class="col-lg-6 mb-4">
                                <div class="card border-0 shadow-sm rounded-lg h-100 overflow-hidden">
                                    <!-- Card Header with Property Name and Status -->
                                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0 text-dark font-weight-bold text-truncate" style="max-width: 65%;">
                                            <i class="fa fa-building text-muted mr-2"></i>
                                            <t t-esc="req.property_id.name or 'Property'"/>
                                        </h5>
                                        <!-- Dynamic Status Badge -->
                                        <span t-attf-class="badge px-3 py-2 font-weight-normal #{'badge-success' if req.state == 'done' else ('badge-info' if req.state == 'in_progress' else 'badge-secondary')}">
                                            <t t-esc="req.state.capitalize() if req.state else 'New'"/>
                                        </span>
                                    </div>

                                    <!-- Card Body Content -->
                                    <div class="card-body bg-light-subtle">
                                        <div class="row mb-2">
                                            <div class="col-6 text-muted small">Reference</div>
                                            <div class="col-6 text-right font-weight-bold text-dark">
                                                <t t-esc="req.name or 'New'"/>
                                            </div>
                                        </div>

                                        <div class="row mb-2">
                                            <div class="col-6 text-muted small">Tenant Phone</div>
                                            <div class="col-6 text-right text-dark">
                                                <i class="fa fa-phone text-muted mr-1"></i>
                                                <t t-esc="req.tenant_phone or '—'"/>
                                            </div>
                                        </div>

                                        <div class="row mb-2">
                                            <div class="col-6 text-muted small">Issue Type</div>
                                            <div class="col-6 text-right">
                                                <span class="badge badge-light border text-dark px-2 py-1" t-field="req.issue_type"/>
                                            </div>
                                        </div>

                                        <div class="row mb-2">
                                            <div class="col-6 text-muted small">Urgency Level</div>
                                            <div class="col-6 text-right">
                                                <span t-attf-class="badge #{'badge-danger' if req.urgency == 'emergency' else ('badge-warning' if req.urgency == 'high' else 'badge-secondary')}" t-esc="req.urgency.capitalize() if req.urgency else 'Normal'"/>
                                            </div>
                                        </div>

                                        <div class="row mb-2">
                                            <div class="col-6 text-muted small">Preferred Date</div>
                                            <div class="col-6 text-right text-dark">
                                                <i class="fa fa-calendar-alt text-muted mr-1"></i>
                                                <t t-esc="req.preferred_date or '—'"/>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-6 text-muted small">Scheduled Date</div>
                                            <div class="col-6 text-right text-dark">
                                                <i class="fa fa-calendar-check-o text-muted mr-1"></i>
                                                <t t-esc="req.scheduled_date or '—'"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="row">
                        <div class="col-12">
                            <div class="alert alert-light border shadow-sm text-center py-4" role="alert">
                                <i class="fa fa-info-circle fa-2x text-muted mb-2"></i>
                                <p class="mb-0 text-muted">No maintenance requests found for your account.</p>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Portal Menu Integration: Maintenance Requests Card on /my/home -->
    <template id="portal_my_maintenance_menu" name="Portal My Home: Maintenance Requests" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'fa fa-wrench'"/>
                <t t-set="title">Maintenance Requests</t>
                <t t-set="text">View and track your property maintenance requests.</t>
                <t t-set="url" t-value="'/my/maintenance'"/>
                <t t-set="config_card" t-value="True"/>
                <t t-set="placeholder_count" t-value="'maintenance_count'"/>
            </t>
        </div>
    </template>
</odoo>