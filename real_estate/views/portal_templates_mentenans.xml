<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Maintenance Request List Page -->
    <template id="portal_my_maintenance_requests" name="My Maintenance Requests">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumb_seo" t-value="'My Maintenance Requests'"/>
            <div class="container py-4">
                <div class="row align-items-center mb-4">
                    <div class="col"><h2 class="text-dark fw-bold mb-0">My Maintenance Requests</h2></div>
                </div>
                <t t-if="not maintenance_requests">
                    <div class="alert alert-info text-center py-4 shadow-sm" role="alert">
                        <i class="fa fa-info-circle fa-2x mb-2 text-info"/>
                        <p class="mb-0">You do not have any maintenance requests yet.</p>
                    </div>
                </t>
                <t t-else="">
                    <div class="row">
                        <t t-foreach="maintenance_requests" t-as="maintenance">
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="card border-0 shadow-sm h-100 rounded-lg overflow-hidden transition-hover">
                                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                                        <span class="badge bg-light text-primary px-3 py-2 rounded-pill font-weight-bold"><span t-field="maintenance.issue_type"/></span>
                                        <span t-if="maintenance.state == 'done'" class="badge bg-success-light text-success px-2 py-1">Done</span>
                                        <span t-elif="maintenance.state == 'in_progress'" class="badge bg-info-light text-info px-2 py-1">In Progress</span>
                                        <span t-else="" class="badge bg-secondary-light text-secondary px-2 py-1"><span t-field="maintenance.state"/></span>
                                    </div>
                                    <div class="card-body">
                                        <h4 class="card-title text-dark font-weight-bold mb-3"><span t-field="maintenance.name"/></h4>
                                        <div class="property-details text-muted small">
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span><i class="fa fa-building text-primary me-2"/> Property:</span>
                                                <strong class="text-dark"><span t-field="maintenance.property_id"/></strong>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 pt-2">
                                                <span><i class="fa fa-exclamation-circle text-primary me-2"/> Urgency:</span>
                                                <strong class="text-dark"><span t-field="maintenance.urgency"/></strong>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 pt-2">
                                                <span><i class="fa fa-calendar text-primary me-2"/> Created:</span>
                                                <strong class="text-dark"><span t-field="maintenance.create_date"/></strong>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-white border-0 pb-4 pt-0">
                                        <a t-att-href="'/my/maintenance/%s' % maintenance.id" class="btn btn-outline-primary btn-block w-100 rounded-pill font-weight-bold">
                                            <i class="fa fa-eye me-1"/> View Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Template: Maintenance Request Detail Page -->
    <template id="portal_maintenance_page" name="Maintenance Request Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumb_seo" t-value="'Maintenance Request: ' + (maintenance_req.name or '')"/>
            
            <div class="container py-4">
                <!-- Breadcrumbs -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb bg-transparent p-0">
                        <li class="breadcrumb-item"><a href="/my/home">My Account</a></li>
                        <li class="breadcrumb-item"><a href="/my/maintenance">Maintenance Requests</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><t t-esc="maintenance_req.name"/></li>
                    </ol>
                </nav>

                <!-- Header card / details view -->
                <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
                    <div class="card-header bg-white py-4 d-flex justify-content-between align-items-center">
                        <h3 class="mb-0 text-dark fw-bold">
                            <i class="fa fa-wrench text-primary me-2"></i> Request: <t t-esc="maintenance_req.name"/>
                        </h3>
                        <span t-if="maintenance_req.state == 'done'" class="badge bg-success-light text-success px-3 py-2">Done</span>
                        <span t-elif="maintenance_req.state == 'in_progress'" class="badge bg-info-light text-info px-3 py-2">In Progress</span>
                        <span t-else="" class="badge bg-secondary-light text-secondary px-3 py-2"><t t-esc="maintenance_req.state.capitalize() if maintenance_req.state else 'New'"/></span>
                    </div>
                    
                    <div class="card-body p-4">
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Property:</strong>
                                <span class="text-dark fs-5"><t t-esc="maintenance_req.property_id.name"/></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Issue Type:</strong>
                                <span class="badge bg-light text-primary px-3 py-2 fs-6"><t t-esc="maintenance_req.issue_type"/></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Urgency Level:</strong>
                                <span class="text-dark"><t t-esc="maintenance_req.urgency.capitalize() if maintenance_req.urgency else 'Normal'"/></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Tenant Phone:</strong>
                                <span class="text-dark"><t t-esc="maintenance_req.tenant_phone or '—'"/></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Preferred Date:</strong>
                                <span class="text-dark"><t t-esc="maintenance_req.preferred_date or '—'"/></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Scheduled Date:</strong>
                                <span class="text-dark"><t t-esc="maintenance_req.scheduled_date or '—'"/></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Portal Menu Integration: Maintenance Card on /my/home -->
    <template id="portal_my_home_maintenance_menu" name="Portal My Home: Maintenance" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'fa fa-wrench'"/>
                <t t-set="title">Maintenance</t>
                <t t-set="text">View and track your maintenance requests.</t>
                <t t-set="url" t-value="'/my/maintenance'"/>
                <t t-set="config_card" t-value="True"/>
                <t t-set="placeholder_count" t-value="'maintenance_count'"/>
            </t>
        </div>
    </template>
</odoo>