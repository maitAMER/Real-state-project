<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template: Tenant Profile / Account Management -->
    <template id="portal_my_account_template" name="My Tenant Account">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumb_seo" t-value="'Tenant Portal'"/>
            <div class="container py-4">
                <div class="row align-items-center mb-4"><div class="col"><h2 class="text-dark fw-bold mb-0">Tenant Portal</h2></div></div>
                <t t-if="tenant">
                    <div class="row"><div class="col-lg-4 col-md-6 mb-4">
                        <div class="card border-0 shadow-sm h-100 rounded-lg overflow-hidden transition-hover">
                            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                                <span class="badge bg-light text-primary px-3 py-2 rounded-pill font-weight-bold">Tenant</span>
                                <span t-if="tenant.active" class="badge bg-success-light text-success px-2 py-1">Active</span>
                                <span t-else="" class="badge bg-danger-light text-danger px-2 py-1">Inactive</span>
                            </div>
                            <div class="card-body">
                                <h4 class="card-title text-dark font-weight-bold mb-3"><span t-field="tenant.name"/></h4>
                                <div class="property-details text-muted small">
                                    <div class="d-flex justify-content-between py-1 border-bottom"><span><i class="fa fa-envelope text-primary me-2"/> Email:</span><strong class="text-dark"><span t-field="tenant.email"/></strong></div>
                                    <div class="d-flex justify-content-between py-1 pt-2"><span><i class="fa fa-map-marker text-primary me-2"/> City:</span><strong class="text-dark"><span t-esc="tenant.city or '—'"/></strong></div>
                                    <div class="d-flex justify-content-between py-1 pt-2"><span><i class="fa fa-home text-primary me-2"/> Leases:</span><strong class="text-dark"><span t-esc="tenant.lease_count"/></strong></div>
                                </div>
                            </div>
                            <div class="card-footer bg-white border-0 pb-4 pt-0"><a t-att-href="'/my/account/%s' % tenant.id" class="btn btn-outline-primary btn-block w-100 rounded-pill font-weight-bold"><i class="fa fa-eye me-1"/> View Details</a></div>
                        </div>
                    </div></div>
                </t>
                <t t-else=""><div class="alert alert-info text-center py-4 shadow-sm" role="alert"><i class="fa fa-info-circle fa-2x mb-2 text-info"/><p class="mb-0">No tenant profile is linked with your user account.</p></div></t>
            </div>
        </t>
    </template>

    <template id="portal_tenant_detail_template" name="Tenant Details">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumb_seo" t-value="'Tenant: ' + (tenant.name or '')"/>
            <div class="container py-4">
                <nav aria-label="breadcrumb" class="mb-4"><ol class="breadcrumb bg-transparent p-0"><li class="breadcrumb-item"><a href="/my/home">My Account</a></li><li class="breadcrumb-item"><a href="/my/account">Tenant Portal</a></li><li class="breadcrumb-item active" aria-current="page"><t t-esc="tenant.name"/></li></ol></nav>
                <t t-if="kw.get('success')"><div class="alert alert-success alert-dismissible fade show" role="alert">Your profile has been updated successfully.<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/></div></t>
                <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
                    <div class="card-header bg-white py-4 d-flex justify-content-between align-items-center"><h3 class="mb-0 text-dark fw-bold"><i class="fa fa-user text-primary me-2"/><t t-esc="tenant.name"/></h3><span t-if="tenant.active" class="badge bg-success-light text-success px-3 py-2">Active</span><span t-else="" class="badge bg-danger-light text-danger px-3 py-2">Inactive</span></div>
                    <div class="card-body p-4">
                        <div class="row mb-3"><div class="col-md-6 mb-3"><strong class="text-muted d-block mb-1">Email:</strong><span class="text-dark fs-5" t-field="tenant.email"/></div><div class="col-md-6 mb-3"><strong class="text-muted d-block mb-1">Date Joined:</strong><span class="text-dark" t-field="tenant.date_joined"/></div></div>
                        <form action="/my/account/update" method="POST"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="row mb-3"><div class="col-md-6 mb-3"><label for="tenant_city" class="text-muted d-block mb-1 fw-bold">City:</label><input id="tenant_city" type="text" name="city" class="form-control" t-att-value="tenant.city or ''"/></div><div class="col-md-6 mb-3"><label for="tenant_phone" class="text-muted d-block mb-1 fw-bold">Phone:</label><input id="tenant_phone" type="text" name="phone" class="form-control" t-att-value="tenant.phone or ''"/></div></div>
                            <div class="row mb-3"><div class="col-md-6 mb-3"><label for="tenant_mobile" class="text-muted d-block mb-1 fw-bold">Mobile:</label><input id="tenant_mobile" type="text" name="mobile" class="form-control" t-att-value="tenant.mobile or ''"/></div><div class="col-md-6 mb-3"><strong class="text-muted d-block mb-1">Age:</strong><span class="text-dark" t-field="tenant.age"/></div></div>
                            <div class="row mb-3"><div class="col-12"><label for="tenant_notes" class="text-muted d-block mb-1 fw-bold">Notes:</label><textarea id="tenant_notes" name="notes" class="form-control" rows="3"><t t-esc="tenant.notes or ''"/></textarea></div></div>
                            <div class="row mb-3"><div class="col-md-6"><strong class="text-muted d-block mb-1">Total Leases:</strong><span class="text-dark" t-esc="tenant.lease_count"/></div></div>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill font-weight-bold"><i class="fa fa-save me-1"/> Save Changes</button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Portal Menu Integration: Tenant Profile Card on /my/home -->
    <template id="portal_my_home_tenant_menu" name="Portal My Home: Tenant Portal" inherit_id="portal.portal_my_home" priority="10">
        <div id="portal_common_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'fa fa-id-card'"/>
                <t t-set="title">Tenant Portal</t>
                <t t-set="text">View and update your personal tenant information.</t>
                <t t-set="url" t-value="'/my/account'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>
</odoo>