<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_tenant_tree" model="ir.ui.view">
        <field name="name">real_estate.tenant.tree</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <tree string="Tenants">
                <field name="name"/>
                <field name="company_type"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="city"/>
                <field name="date_joined"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_tenant_form" model="ir.ui.view">
        <field name="name">real_estate.tenant.form</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <form string="Tenant">
                <header>
                    <button name="set_name_in_notes" string="Add Name to Notes" groups="real_estate.group_tenant" type="object" class="btn-primary"/>
                    <button name="add_crm_lead_name_to_notes" groups="real_estate.group_tenant_manager" string="Add CRM Lead Name to Notes" type="object" class="btn-primary"/>
                    <button name="action_create_portal_user" string="Create Portal User" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <!-- وضع الاختيار في الأعلى أفقياً مثل الـ Contacts -->
                    <field name="company_type" widget="radio" options="{'horizontal': true}"/>

                    <div name="button_box" class="oe_button_box">
                        <button name="action_lease" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="lease_count" widget="statinfo" string="Leases"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tenant Name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Contact Information">
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="city"/>
                            <field name="age_category" invisible="company_type != 'person'"/>
                            <field name="user_id"/>
                            <field name="age" invisible="company_type != 'person'"/>
                        </group>

                        <group string="Additional Information">
                            <field name="date_joined"/>
                            <field name="date_of_birth" invisible="company_type != 'person'"/>
                            <field name="active"/>
                            <field name="crm_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Add notes about the tenant..."/>
                        </page>
                        <page string="Leases">
                            <field name="lease_ids">
                                <tree create="false" delete="false">
                                    <field name="name"/>
                                    <field name="tenant_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="monthly_rent"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description" placeholder="Description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tenant Search View -->
    <record id="view_tenant_search" model="ir.ui.view">
        <field name="name">real_estate.tenant.search</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <search string="Search Tenants">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="company_type"/>
                <field name="age_category"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Company Type" name="group_by_company_type" context="{'group_by': 'company_type'}"/>
                    <filter string="Age Category" name="group_by_age_category" context="{'group_by': 'age_category'}"/>
                    <filter string="City" name="group_by_city" context="{'group_by': 'city'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tenant Kanban View -->
    <record id="view_tenant_kanban" model="ir.ui.view">
        <field name="name">real_estate.tenant.kanban</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="email"/>
                <field name="date_joined"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <field name="email" widget="email"/>
                                </div>
                                <div class="text-muted mt-1">
                                    Joined: <field name="date_joined"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tenant Profile views and action -->
    <record id="view_tenant_profile_tree" model="ir.ui.view">
        <field name="name">real_estate.tenant.profile.tree</field>
        <field name="model">real_estate.tenant.profile</field>
        <field name="arch" type="xml">
            <tree string="Tenant Profiles">
                <field name="profile_name"/>
                <field name="profile_email"/>
                <field name="profile_phone"/>
            </tree>
        </field>
    </record>

    <record id="view_tenant_profile_form" model="ir.ui.view">
        <field name="name">real_estate.tenant.profile.form</field>
        <field name="model">real_estate.tenant.profile</field>
        <field name="arch" type="xml">
            <form string="Tenant Profile">
                <sheet>
                    <group>
                        <field name="profile_name"/>
                        <field name="profile_email"/>
                        <field name="profile_phone"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tenant_profile" model="ir.actions.act_window">
        <field name="name">Tenant Profiles</field>
        <field name="res_model">real_estate.tenant.profile</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action -->
    <record id="action_real_estate_tenant" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">real_estate.tenant</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first tenant!
            </p>
        </field>
    </record>
</odoo>