<odoo>


    <record id="property_category" model="ir.module.category">
        <field name="name">Real Estate property</field>
    </record>
    <record id="tenant_category" model="ir.module.category">
        <field name="name">Real Estate Tenant</field>
    </record>
    <record id="lease_category" model="ir.module.category">
        <field name="name">Real Estate lease</field>
    </record>

    <record id="booking_category" model="ir.module.category">
        <field name="name">Real Estate booking</field>
    </record>

    <!-- Property Manager and Property User Groups -->
     <record id="group_property_manager" model="res.groups">
        <field name="name">Property Manager</field>
        <field name="category_id" ref="real_estate.property_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
     <record id="group_property_user" model="res.groups">
        <field name="name">Property user</field>
        <field name="category_id" ref="real_estate.property_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

<!--Record_rule-->

  <record id="property_rule_by_user" model="ir.rule">
        <field name="name">Property User</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_property_user'))]"/>
    </record>


    <!-- tenant Manager and tenant User Groups -->
   <record id="group_tenant_manager" model="res.groups">
        <field name="name">Tenant Manager</field>
        <field name="category_id" ref="real_estate.tenant_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_tenant_user" model="res.groups">
        <field name="name">Tenant User</field>
        <field name="category_id" ref="real_estate.tenant_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

<!--Record_rule-->

  <record id="tenant_rule_by_user" model="ir.rule">
        <field name="name">Tenant User</field>
        <field name="model_id" ref="model_real_estate_tenant"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_tenant_user'))]"/>
    </record>




      <!-- lease Manager and lease User Groups -->
   <record id="group_lease_manager" model="res.groups">
        <field name="name">Lease Manager</field>
        <field name="category_id" ref="real_estate.lease_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

      <record id="group_lease_user" model="res.groups">
        <field name="name">Lease User</field>
        <field name="category_id" ref="real_estate.lease_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!--Record_rule-->

  <record id="lease_rule_by_user" model="ir.rule">
        <field name="name">Lease User</field>
        <field name="model_id" ref="model_real_estate_lease"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_lease_user'))]"/>
    </record>


         <!-- booking Manager and booking User Groups -->
   <record id="group_booking_manager" model="res.groups">
        <field name="name">Booking Manager</field>
        <field name="category_id" ref="real_estate.booking_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

      <record id="group_booking_user" model="res.groups">
        <field name="name">Booking User</field>
        <field name="category_id" ref="real_estate.booking_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!--Record_rule-->

  <record id="booking_rule_by_user" model="ir.rule">
        <field name="name">Booking User</field>
        <field name="model_id" ref="model_real_estate_booking"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_booking_user'))]"/>
    </record>

</odoo>