<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template: My Payments List -->
    <template id="portal_my_payments_template" name="My Payments">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumb_seo" t-value="'My Payments'"/>
            
            <div class="container py-4">
                <div class="row align-items-center mb-4">
                    <div class="col">
                        <h2 class="text-dark fw-bold mb-0">My Payments</h2>
                    </div>
                </div>

                <t t-if="not payments">
                    <div class="alert alert-info text-center py-4 shadow-sm" role="alert">
                        <i class="fa fa-info-circle fa-2x mb-2 text-info"></i>
                        <p class="mb-0">You do not have any payments recorded yet.</p>
                    </div>
                </t>
                
                <t t-else="">
                    <div class="row">
                        <t t-foreach="payments" t-as="pay">
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="card border-0 shadow-sm h-100 rounded-lg overflow-hidden transition-hover">
                                    
                                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                                        <span class="badge bg-light text-primary px-3 py-2 rounded-pill font-weight-bold">
                                            <span t-field="pay.name"/>
                                        </span>
                                        <span t-if="pay.state == 'paid'" class="badge bg-success-light text-success px-2 py-1">Paid</span>
                                        <span t-elif="pay.state == 'pending'" class="badge bg-warning-light text-warning px-2 py-1">Pending</span>
                                        <span t-elif="pay.state == 'reconciled'" class="badge bg-info-light text-info px-2 py-1">Reconciled</span>
                                        <span t-else="" class="badge bg-secondary-light text-secondary px-2 py-1">Draft</span>
                                    </div>

                                    <div class="card-body">
                                        <h4 class="card-title text-dark font-weight-bold mb-3">
                                            Total: <t t-esc="pay.total_amount"/>
                                        </h4>
                                        
                                        <div class="payment-details text-muted small">
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span><i class="fa fa-calendar text-primary me-2"></i> Due Date:</span>
                                                <strong class="text-dark"><span t-field="pay.due_date"/></strong>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 pt-2">
                                                <span><i class="fa fa-money text-primary me-2"></i> Amount Due:</span>
                                                <strong class="text-dark"><span t-field="pay.amount"/></strong>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="card-footer bg-white border-0 pb-4 pt-0">
                                        <a t-att-href="'/my/payment/%s' % pay.id" class="btn btn-outline-primary btn-block w-100 rounded-pill font-weight-bold">
                                            <i class="fa fa-eye me-1"></i> View Details
                                        </a>
                                    </div>

                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Template: Payment Detail Page -->
    <template id="portal_payment_page" name="Payment Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumb_seo" t-value="'Payment: ' + (payment_record.name or '')"/>
            
            <div class="container py-4">
                <!-- Breadcrumbs -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb bg-transparent p-0">
                        <li class="breadcrumb-item"><a href="/my/home">My Account</a></li>
                        <li class="breadcrumb-item"><a href="/my/payments">My Payments</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><t t-esc="payment_record.name"/></li>
                    </ol>
                </nav>

                <!-- Payment Details Card -->
                <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
                    <div class="card-header bg-white py-4 d-flex justify-content-between align-items-center">
                        <h3 class="mb-0 text-dark fw-bold">
                            <i class="fa fa-credit-card text-primary me-2"></i> Payment Reference: <t t-esc="payment_record.name"/>
                        </h3>
                        <span t-if="payment_record.state == 'paid'" class="badge bg-success-light text-success px-3 py-2">Paid</span>
                        <span t-elif="payment_record.state == 'pending'" class="badge bg-warning-light text-warning px-3 py-2">Pending</span>
                        <span t-elif="payment_record.state == 'reconciled'" class="badge bg-info-light text-info px-3 py-2">Reconciled</span>
                        <span t-else="" class="badge bg-secondary-light text-secondary px-3 py-2">Draft</span>
                    </div>
                    
                    <div class="card-body p-4">
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Lease:</strong>
                                <span class="text-dark fs-5"><t t-esc="payment_record.lease_id.name"/></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Total Amount:</strong>
                                <span class="text-success fs-5 fw-bold"><t t-esc="payment_record.total_amount"/></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Due Date:</strong>
                                <span class="text-dark"><t t-esc="payment_record.due_date"/></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Payment Date:</strong>
                                <span class="text-dark"><t t-esc="payment_record.payment_date or '—'"/></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Payment Method:</strong>
                                <span class="badge bg-light text-primary px-3 py-2 fs-6"><t t-esc="payment_record.payment_method or '—'"/></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Late Fee:</strong>
                                <span class="text-danger"><t t-esc="payment_record.late_fee"/></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Portal Menu Integration: Payments Card on /my/home -->
    <template id="portal_my_home_payments_menu" name="Portal My Home: Payments" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'fa fa-money'"/>
                <t t-set="title">Payments</t>
                <t t-set="text">View and track your lease payments.</t>
                <t t-set="url" t-value="'/my/payments'"/>
                <t t-set="config_card" t-value="True"/>
                <t t-set="placeholder_count" t-value="'payment_count'"/>
            </t>
        </div>
    </template>
</odoo>