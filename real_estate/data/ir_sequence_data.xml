<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    <!--Real Estate Lease-->
        <record id="seq_real_estate_lease" model="ir.sequence">
            <field name="name">Real Estate Lease</field>
            <field name="code">real_estate.lease</field>
            <field name="prefix">LEASE/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_maintenance_request" model="ir.sequence">
            <field name="name">Maintenance Request</field>
            <field name="code">maintenance.request.sequence</field>
            <field name="prefix">MNT/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>


 <!--Real Estate Property-->
       <record id="seq_real_estate_property" model="ir.sequence">
            <field name="name">Real Estate Property</field>
            <field name="code">real_estate.property</field>
            <field name="prefix">PROP/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>


         <!--Real Estate booking-->
       <record id="seq_real_estate_booking" model="ir.sequence">
            <field name="name">Real Estate booking</field>
            <field name="code">real_estate.booking</field>
            <field name="prefix">BOOK/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

 <!--Real Estate tenant-->
       <record id="seq_real_estate_tenant" model="ir.sequence">
            <field name="name">Real Estate Tenant</field>
            <field name="code">real_estate.tenant</field>
            <field name="prefix">TEN/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- <record id="seq_lease_payment" model="ir.sequence">
            <field name="name">Lease Payment</field>
            <field name="code">lease.payment</field>
            <field name="prefix">PMT/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record> -->

    </data>
</odoo>
