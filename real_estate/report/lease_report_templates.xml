<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_lease_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #333;">
                        
                        <!-- Header Section -->
                        <div class="row mb-4 pb-2 border-bottom align-items-center">
                            <div class="col-8">
                                <h2 style="font-weight: 700; color: #2c3e50; margin-bottom: 5px;">
                                    Lease Summary
                                </h2>
                                <h5 class="text-muted font-weight-light">
                                    Reference: <span t-field="o.name" style="font-weight: 600; color: #34495e;"/>
                                </h5>
                            </div>
                            <div class="col-4 text-end">
                                <!-- تم إصلاح طريقة التحقق لتفادي الخطأ -->
                                <!-- <span class="badge bg-secondary p-2" style="font-size: 0.9rem;" t-field="o.state" t-if="'state' in o._fields"/> -->
                            </div>
                        </div>

                        <!-- General Info Card -->
                        <div class="card bg-light border-0 p-3 mb-4 rounded shadow-sm">
                            <div class="row">
                                <div class="col-4">
                                    <small class="text-muted d-block uppercase font-weight-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">TENANT</small>
                                    <span t-field="o.tenant_id" style="font-size: 1.05rem; font-weight: 600; color: #2c3e50;"/>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted d-block uppercase font-weight-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">START DATE</small>
                                    <span t-field="o.start_date" t-options="{'widget': 'date'}" style="font-size: 1rem; color: #34495e;"/>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted d-block uppercase font-weight-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">END DATE</small>
                                    <span t-field="o.end_date" t-options="{'widget': 'date'}" style="font-size: 1rem; color: #34495e;"/>
                                </div>
                            </div>
                        </div>

                        <!-- Lease Financial & Property Information -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h4 style="font-size: 1.1rem; font-weight: 600; color: #2c3e50; border-bottom: 2px solid #e9ecef; padding-bottom: 8px; margin-bottom: 15px;">
                                    Lease Details
                                </h4>
                                <table class="table table-borderless">
                                    <tbody>
                                        <tr style="border-bottom: 1px solid #f1f2f6;">
                                            <td style="width: 30%; color: #7f8c8d;"><strong>Property:</strong></td>
                                            <td><span t-field="o.property_id" style="font-weight: 500;"/></td>
                                        </tr>
                                        <tr>
                                            <td style="color: #7f8c8d;"><strong>Monthly Rent:</strong></td>
                                            <td class="text-end">
                                                <span t-field="o.monthly_rent"
                                                      t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                                                      style="font-size: 1.1rem; font-weight: 700; color: #27ae60;"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Maintenance Requests Table -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h4 style="font-size: 1.1rem; font-weight: 600; color: #2c3e50; border-bottom: 2px solid #e9ecef; padding-bottom: 8px; margin-bottom: 15px;">
                                    Maintenance Requests
                                </h4>
                                <t t-if="o.maintenance_request_ids">
                                    <table class="table table-sm table-striped align-middle">
                                        <thead style="background-color: #f8f9fa; color: #2c3e50;">
                                            <tr>
                                                <th style="padding: 10px;">Request</th>
                                                <th style="padding: 10px;">Issue</th>
                                                <th style="padding: 10px;">Description</th>
                                                <th style="padding: 10px;" class="text-end">Actual Cost</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="o.maintenance_request_ids" t-as="request">
                                                <tr>
                                                    <td style="padding: 10px;"><span t-field="request.name" style="font-weight: 600;"/></td>
                                                    <td style="padding: 10px;"><span t-field="request.issue_type"/></td>
                                                    <td style="padding: 10px;"><span t-field="request.description" class="text-muted"/></td>
                                                    <td style="padding: 10px;" class="text-end">
                                                        <span t-field="request.actual_cost" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>

                                    <!-- Total Maintenance Actual Cost Section -->
                                    <div class="row mt-3">
                                        <div class="col-12 text-end">
                                            <strong style="color: #2c3e50;">Total  Actual Cost: </strong>
                                            <span t-esc="total_actual_costs.get(o.id, 0.0)"
                                                  t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"
                                                  style="font-weight: bold; color: #27ae60; font-size: 1.05rem;"/>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="p-3 bg-light rounded text-center text-muted">
                                        <small>No maintenance requests recorded for this lease.</small>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Footer Timestamp -->
                        <div class="row mt-5 pt-3 border-top">
                            <div class="col-12 text-end">
                                <p class="text-muted" style="font-size: 0.8rem;">
                                    Generated on <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                                </p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>