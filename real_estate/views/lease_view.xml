<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <!-- Tree View-->
    <record id="view_lease_tree" model="ir.ui.view">
        <field name="name">real_estate.lease.tree</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <tree string="Leases">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="monthly_rent"/>
                <field name="deposit_paid"/>
                <field name="booking_id"/>
                <field name="state"/>
                <button name="send_reminder_email" type="object" string="Email" icon="fa-envelope"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_lease_search" model="ir.ui.view">
        <field name="name">real_estate.lease.search</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <search string="Search Leases">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <!--Group by-->
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Property" name="group_by_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Tenant" name="group_by_tenant" context="{'group_by': 'tenant_id'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View-->
    <record id="view_lease_kanban" model="ir.ui.view">
        <field name="name">real_estate.lease.kanban</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="monthly_rent"/>
                <field name="deposit_paid"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    Property: <field name="property_id"/>
                                </div>
                                <div class="mt-1">
                                    Tenant: <field name="tenant_id"/>
                                </div>
                                <div class="mt-1">
                                    Start: <field name="start_date"/>
                                </div>
                                <div class="mt-1">
                                    End: <field name="end_date"/>
                                </div>
                                <div class="mt-1 text-muted">
                                    Rent: <field name="monthly_rent"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View-->
    <record id="view_lease_form" model="ir.ui.view">
        <field name="name">real_estate.lease.form</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <form string="Lease">
                <header>
                    <!-- زرار إرسال الإيميل الجديد -->
                    <button name="send_reminder_email" type="object" string="Send Reminder Email" class="oe_highlight"/>
                    
                    <button name="convert_to_active" type="object" string="Activate" class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_create_maintenance_request" type="object" string="Create Request" class="oe_highlight"/>
                    <button name="convert_to_draft" type="object" string="Mark as Draft" class="oe_highlight" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,at_risk,expired" options="{'clickable':1}"/>
                    <button name="action_create_electrical_charge_request" type="object" string="Create Newer Charge Request" class="oe_highlight"/>
                </header>
                
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_maintenance_requests" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_request_count" widget="statinfo" string="Maintenance Requests"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- الصف الأول: المعلومات الأساسية والتواريخ والمدة -->
                    <group>
                        <group string="Lease Information">
                            <field name="property_id"/>
                            <field name="tenant_id"/>
                            <field name="user_id"/>
                            <field name="booking_id"/>
                            <!-- حقل الـ Specialization -->
                            <field name="specialization"/>
                        </group>
                        
                        <group string="Dates &amp; Timeline">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration_months"/>
                            <field name="next_electrical_charge"/>
                            <!-- حقول الدفع والتذكير الجديدة -->
                            <field name="next_payment_date"/>
                            <field name="last_reminder_sent"/>
                        </group>
                    </group>

                    <!-- الصف الثاني: التفاصيل المالية وتفاصيل تكاليف الصيانة -->
                    <group>
                        <group string="Financial Details">
                            <field name="monthly_rent"/>
                            <field name="deposit_paid"/>
                        </group>
                        
                        <group string="Maintenance Cost Breakdown">
                            <field name="plumbing_cost" readonly="1"/>
                            <field name="electrical_cost" readonly="1"/>
                            <field name="air_condition_cost" readonly="1"/>
                            <field name="appliance_cost" readonly="1"/>
                            <field name="other_cost" readonly="1"/>
                            <div class="oe_subtotal_footer_separator oe_inline" style="border-top: 2px solid #123457; padding-top: 5px;">
                                <label for="total_cost" string="Total Maintenance Cost"/>
                            </div>
                            <field name="total_cost" readonly="1" nolabel="1" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- صفحة طلبات الصيانة -->
                        <page string="Maintenance Requests">
                            <field name="maintenance_request_ids" readonly="1">
                                <tree>
                                    <field name="issue_type"/>
                                    <field name="urgency"/>
                                    <field name="preferred_date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>

                        <!-- صفحة ملخص المدفوعات الجديدة -->
                        <page string="Payment Information">
                            <group>
                                <group string="Payment Methods Breakdown">
                                    <field name="total_cash_amount" readonly="1"/>
                                    <field name="total_visa_amount" readonly="1"/>
                                </group>
                                <group string="Total Payments Summary">
                                    <field name="total_payment_amount" readonly="1" class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action-->
    <record id="action_lease" model="ir.actions.act_window">
        <field name="name">Leases</field>
        <field name="res_model">real_estate.lease</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_lease_search"/>
    </record>

    <!-- Scheduled Action (Cron Job) -->
    <record id="ir_cron_auto_expire_leases" model="ir.cron">
        <field name="name">Real Estate: Auto Expire Leases</field>
        <field name="model_id" ref="model_real_estate_lease"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_expire_leases()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>