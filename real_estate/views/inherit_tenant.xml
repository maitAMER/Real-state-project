<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- =========================
         TENANT ACTION
    ========================== -->

    <record id="action_real_estate_tenant" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">real_estate.tenant</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- =========================
         TENANT TREE VIEW
    ========================== -->

    <record id="view_real_estate_tenant_tree" model="ir.ui.view">
        <field name="name">real.estate.tenant.tree</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">

            <tree>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="city"/>
                <field name="date_joined"/>
                <field name="age"/>
                <field name="age_category"/>
                <field name="active"/>
            </tree>

        </field>
    </record>


    <!-- =========================
         TENANT FORM VIEW
    ========================== -->

    <record id="view_real_estate_tenant_form" model="ir.ui.view">
        <field name="name">real.estate.tenant.form</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>


                    <!-- Tenant Profile -->
                    <group string="Tenant Profile">

                        <field name="profile_id"/>

                    </group>


                    <!-- Basic Information -->
                    <group string="Basic Information">

                        <group>
                            <field name="profile_email"/>
                            <field name="profile_phone"/>
                            <field name="city"/>
                        </group>

                        <group>
                            <field name="date_joined"/>
                            <field name="date_of_birth"/>
                            <field name="age"/>
                            <field name="age_category"/>
                        </group>

                    </group>


                    <!-- User Information -->
                    <group string="User Information">

                        <field name="user_id"/>
                        <field name="crm_id"/>
                        <field name="active"/>

                    </group>


                    <!-- Notes & Description -->
                    <notebook>

                        <page string="Notes">
                            <field name="notes"/>
                        </page>

                        <page string="Description">
                            <field name="description"/>
                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- =========================
         TENANT PROFILE ACTION
    ========================== -->

    <record id="action_tenant_profile" model="ir.actions.act_window">
        <field name="name">Tenant Profiles</field>
        <field name="res_model">real_estate.tenant.profile</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- =========================
         TENANT PROFILE TREE VIEW
    ========================== -->

    <record id="view_tenant_profile_tree" model="ir.ui.view">
        <field name="name">real.estate.tenant.profile.tree</field>
        <field name="model">real_estate.tenant.profile</field>
        <field name="arch" type="xml">

            <tree>
                <field name="profile_name"/>
                <field name="profile_email"/>
                <field name="profile_phone"/>
            </tree>

        </field>
    </record>


    <!-- =========================
         TENANT PROFILE FORM VIEW
    ========================== -->

    <record id="view_tenant_profile_form" model="ir.ui.view">
        <field name="name">real.estate.tenant.profile.form</field>
        <field name="model">real_estate.tenant.profile</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="profile_name"/>
                        </h1>
                    </div>

                    <group string="Profile Information">

                        <field name="profile_email"/>
                        <field name="profile_phone"/>

                    </group>

                </sheet>

            </form>

        </field>
    </record>

</odoo>