<odoo>
    <!-- Property List View (Tree) -->
    <record id="view_property_tree" model="ir.ui.view">
        <field name="name">real_estate.property.tree</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
        <tree  class="property_custom" multi_edit="1" string="Properties" decoration-info="property_type == 'apartment'" decoration-warning="property_type == 'villa'">
        <field name="create_date"/>
         <field name="create_uid"/>
        <field name="name"/>
        <field name="property_type"/>
        <field name="price"/>
        <field name="bedrooms"/>
        </tree>
        </field>
    </record>

    <!-- Property Action (Links views together) -->
    <record id="action_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real_estate.property</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property
            </p>
        </field>
    </record>


   <record id="view_property_search" model="ir.ui.view">
        <field name="name">real_estate.property.search</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name"/>
                <field name="price"/>
                <separator/>
                <filter string="available" name="available" domain="[('available', '=', True)]"/>
               
             <filter string="not available" name="not_available" domain="[('available', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_type" context="{'group_by': 'property_type'}"/>
                    <filter string="Availability" name="group_by_availability" context="{'group_by': 'available'}"/>
                </group>

            </search>
        </field>
    </record>



    <!-- Property Kanban View -->
    <record id="view_property_kanban" model="ir.ui.view">
        <field name="name">real_estate.property.kanban</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="property_type"/>
                <field name="price"/>
                <field name="bedrooms"/>
                <field name="available"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <field name="property_type"/>
                                </div>
                                <div class="mt-1">
                                    Price: <field name="price"/>
                                </div>
                                <div class="mt-1">
                                    Bedrooms: <field name="bedrooms"/>
                                </div>
                                <div class="mt-1 text-muted">
                                    Available: <field name="available"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>



 <!-- Property Form View -->
    <record id="view_property_form" model="ir.ui.view">
        <field name="name">real_estate.property.form</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
        <form string="Property">
  <header>
    <!-- زرار ينقل الحالة لـ pending مثلاً -->
    <button name="action_pending" string="Mark as Pending" type="object" class="oe_highlight" invisible="state != 'draft'"/>
    
    <!-- زرار ينقل الحالة لـ sold -->
    <button name="action_sold" string="Mark as Sold" type="object" class="oe_highlight" invisible="state == 'sold' or state == 'closed'"/>
    
    <!-- زرار ينقل الحالة لـ closed -->
    <button name="action_closed" string="Close Property" type="object" class="btn-primary" invisible="state == 'closed'"/>

    <!-- باقي الأزرار العادية بتاعتك -->
    <button name="write_description_text" string="Write Description" type="object" class="btn-primary"/>
    <button name="write_agent_name_to_description" string="Add Agent Name to Description" type="object" class="btn-primary"/>
    <button name="Increase_deposit" string="Increase Deposit" type="object" class="btn-primary"/>
    <button name="add_bedrooms" string="Add Bedrooms" type="object" class="btn-primary"/>
    <button name="action_print_property_summary" string="Print Summary Report" type="object" class="btn-primary"/>
    <button name="action_export_excel" string="Download Excel Report" type="object" class="btn-primary"/>

    
    <field name="available" invisible="1"/>

    <!-- شريط الـ Status Bar -->
    <field name="state" widget="statusbar" statusbar_visible="draft,pending,sold,closed"/>
</header>


         <sheet>
           <div name="button_box" class="oe_button_box">
                    <button name="action_lease" type="object" class="oe_stat_button" icon="fa-wrench">
                        <field name="lease_count" widget="statinfo" string="lease"/>
                    </button>
                  </div>
        <div class="oe_title">

        <h1>
        <field name="name" placeholder="Property Name"/>
        </h1>
        </div>
        <group string="Property Details">
        <group>

        <field name="available"/>
        </group>
        <group>
        <field name="price"/>
        <field name="deposit" string="depositamount"/>

        </group>
        </group>
         <group>
         <group>
        <field name="property_type"/>
        <field name="agent_id"/>

       <field name="bedrooms" readonly="0"/>
<field name="create_date" readonly="1"/>
       <field name="create_uid"/>



                            
        </group>
        </group>
        


        
        <notebook>
            <!-- تمت إضافة تبويب Leases هنا -->
            <page string="Leases">
                <field name="lease_ids">
                    <tree>
                        <field name="name"/>
                        <field name="tenant_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="monthly_rent"/>
                        <field name="state"/>
                    </tree>
                </field>
            </page>

            <page string="Description">
                <field name="description" placeholder="Description"/>
            </page>
        </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Server Action to Open Change State Wizard -->
    <record id="property_change_state_server_action" model="ir.actions.server">
        <field name="name">Change State</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="binding_model_id" ref="model_real_estate_property"/>
        <field name="state">code</field>
        <field name="code">
            action = records.action_open_change_state_wizard()
        </field>
    </record>
</odoo>