<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template: My Properties List -->
    <template id="portal_my_properties_template" name="My Properties">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumb_seo" t-value="'My Properties'"/>
            
            <div class="container py-4">
                <div class="row align-items-center mb-4">
                    <div class="col">
                        <h2 class="text-dark fw-bold mb-0">My Properties</h2>
                    </div>
                </div>

                <t t-if="not properties">
                    <div class="alert alert-info text-center py-4 shadow-sm" role="alert">
                        <i class="fa fa-info-circle fa-2x mb-2 text-info"></i>
                        <p class="mb-0">You do not have any properties assigned yet.</p>
                    </div>
                </t>
                
                <t t-else="">
                    <div class="row">
                        <t t-foreach="properties" t-as="prop">
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="card border-0 shadow-sm h-100 rounded-lg overflow-hidden transition-hover">
                                    
                                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                                        <span class="badge bg-light text-primary px-3 py-2 rounded-pill font-weight-bold">
                                            <span t-field="prop.property_type"/>
                                        </span>
                                        <span t-if="prop.available" class="badge bg-success-light text-success px-2 py-1">Available</span>
                                        <span t-else="" class="badge bg-danger-light text-danger px-2 py-1">Occupied</span>
                                    </div>

                                    <div class="card-body">
                                        <h4 class="card-title text-dark font-weight-bold mb-3">
                                            <t t-esc="prop.name"/>
                                        </h4>
                                        
                                        <div class="property-details text-muted small">
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span><i class="fa fa-money text-primary me-2"></i> Monthly Rent:</span>
                                                <strong class="text-dark"><span t-field="prop.price"/></strong>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 pt-2">
                                                <span><i class="fa fa-bed text-primary me-2"></i> Bedrooms:</span>
                                                <strong class="text-dark"><span t-field="prop.bedrooms"/></strong>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="card-footer bg-white border-0 pb-4 pt-0">
                                        <a t-att-href="'/my/property/%s' % prop.id" class="btn btn-outline-primary btn-block w-100 rounded-pill font-weight-bold">
                                            <i class="fa fa-eye me-1"></i> View Details
                                        </a>
                                    </div>

                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Template: Property Detail Page -->
    <template id="portal_property_page" name="Property Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumb_seo" t-value="'Property: ' + (property_record.name or '')"/>
            
            <div class="container py-4">
                <!-- Breadcrumbs -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb bg-transparent p-0">
                        <li class="breadcrumb-item"><a href="/my/home">My Account</a></li>
                        <li class="breadcrumb-item"><a href="/my/properties">My Properties</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><t t-esc="property_record.name"/></li>
                    </ol>
                </nav>

                <!-- Property Details Card -->
                <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
                    <div class="card-header bg-white py-4 d-flex justify-content-between align-items-center">
                        <h3 class="mb-0 text-dark fw-bold">
                            <i class="fa fa-building text-primary me-2"></i> <t t-esc="property_record.name"/>
                        </h3>
                        <span t-if="property_record.available" class="badge bg-success-light text-success px-3 py-2">Available</span>
                        <span t-else="" class="badge bg-danger-light text-danger px-3 py-2">Occupied</span>
                    </div>
                    
                    <div class="card-body p-4">
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Property Type:</strong>
                                <span class="badge bg-light text-primary px-3 py-2 fs-6"><t t-esc="property_record.property_type"/></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Monthly Rent:</strong>
                                <span class="text-dark fs-5 fw-bold"><t t-esc="property_record.price"/></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Bedrooms:</strong>
                                <span class="text-dark"><t t-esc="property_record.bedrooms"/></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <strong class="text-muted d-block mb-1">Deposit:</strong>
                                <span class="text-dark"><t t-esc="property_record.deposit"/></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <strong class="text-muted d-block mb-1">Description:</strong>
                                <p class="text-dark bg-light p-3 rounded"><t t-esc="property_record.description"/></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Portal Menu Integration: Properties Card on /my/home -->
    <template id="portal_my_home_properties_menu" name="Portal My Home: Properties" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'fa fa-building'"/>
                <t t-set="title">Properties</t>
                <t t-set="text">View and manage your assigned properties.</t>
                <t t-set="url" t-value="'/my/properties'"/>
                <t t-set="config_card" t-value="True"/>
                <t t-set="placeholder_count" t-value="'property_count'"/>
            </t>
        </div>
    </template>

    <!-- Template: Public Properties List with Filter Bar -->
    <template id="property_list_template" name="Public Properties List">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    
                    <!-- Title Header -->
                    <div class="row mb-4">
                        <div class="col-md-12 text-center">
                            <h1 class="fw-bold text-dark">Available Properties</h1>
                            <p class="text-muted">Explore our latest real estate listings available for rent and sale.</p>
                        </div>
                    </div>

                    <!-- Filter Form Section -->
                    <div class="card shadow-sm border-0 p-4 mb-5 bg-light rounded">
                        <form action="/properties" method="get">
                            <div class="row g-3 align-items-end">
                                
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold text-muted">Property Type</label>
                                    <input type="text" name="search_type" class="form-control" placeholder="All Types" t-att-value="search_type"/>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label small fw-bold text-muted">Min Price</label>
                                    <input type="number" name="min_price" class="form-control" placeholder="0" t-att-value="min_price"/>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label small fw-bold text-muted">Max Price</label>
                                    <input type="number" name="max_price" class="form-control" placeholder="Any" t-att-value="max_price"/>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label small fw-bold text-muted">Min Bedrooms</label>
                                    <input type="number" name="min_bedrooms" class="form-control" placeholder="Any" t-att-value="min_bedrooms"/>
                                </div>

                                <div class="col-md-3 d-flex gap-2">
                                    <button type="submit" class="btn btn-primary w-100 font-weight-bold">Search</button>
                                    <a href="/properties" class="btn btn-secondary w-100">Clear</a>
                                </div>

                            </div>
                        </form>
                    </div>

                    <!-- Properties Grid Cards -->
                    <t t-if="not properties">
                        <div class="alert alert-warning text-center py-4" role="alert">
                            <i class="fa fa-info-circle fa-2x mb-2"></i>
                            <p class="mb-0">No properties available at the moment. Please check back later.</p>
                        </div>
                    </t>
                    
                    <t t-else="">
                        <div class="row">
                            <t t-foreach="properties" t-as="prop">
                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="card border-0 shadow-sm h-100 rounded-lg overflow-hidden">
                                        <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                                            <span class="badge bg-light text-primary px-3 py-2 rounded-pill font-weight-bold">
                                                <span t-field="prop.property_type"/>
                                            </span>
                                        </div>

                                        <div class="card-body">
                                            <h4 class="card-title text-dark fw-bold mb-3">
                                                <t t-esc="prop.name"/>
                                            </h4>
                                            
                                            <div class="property-details text-muted small">
                                                <div class="d-flex justify-content-between py-1 border-bottom">
                                                    <span><i class="fa fa-money text-primary me-2"></i> Monthly Rent:</span>
                                                    <strong class="text-dark"><span t-field="prop.price"/></strong>
                                                </div>
                                                <div class="d-flex justify-content-between py-1 pt-2">
                                                    <span><i class="fa fa-bed text-primary me-2"></i> Bedrooms:</span>
                                                    <strong class="text-dark"><span t-field="prop.bedrooms"/></strong>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>

                </div>
            </div>
        </t>
    </template>
</odoo>