<odoo>
<record id="view_lease_report_wizard_form" model="ir.ui.view">
<field name="name">rent.roll.wizard.form</field>
<field name="model">rent.roll.wizard</field>
<field name="arch" type="xml">
<form string="Rent Roll Report">
<group>
<group>
<field name="date_from"/>
<field name="date_to"/>
</group>
<group>
<field name="property_type"/>
</group>
</group>
<group invisible="not excel_file">
<field name="excel_file" filename="excel_filename" readonly="1"/>
<field name="excel_filename" invisible="1"/>
</group>
<footer>
<button string="Generate Report" name="action_generate_report" type="object" class="btn-primary" invisible="excel_file != False"/>
<button string="Close" special="cancel" class="btn-secondary"/>
</footer>
</form>
</field>
</record>
<record id="action_lease_report_wizard" model="ir.actions.act_window">
<field name="name">Rent Roll Report</field>
<field name="res_model">rent.roll.wizard</field>
<field name="view_mode">form</field>
<field name="target">new</field>
</record>

<menuitem id="menu_lease_report"
          name="Rent Roll Report"
          parent="menu_Reports"
          action="action_lease_report_wizard"
          groups="real_estate.group_property_manager"
          sequence="10"/>

</odoo>